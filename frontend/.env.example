# ===================================================
# AmbuRoute Frontend Environment Configuration
# ===================================================

# [Option 1] Mapbox API Key / Access Token (Optional)
# Get a free key at: https://account.mapbox.com/
# Example: VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXIiLCJhIjoiY2x4eHh4...
VITE_MAPBOX_TOKEN=

# [Option 2] Stadia Maps API Key (Optional)
# Get a free key at: https://stadiamaps.com/
VITE_STADIA_API_KEY=

# [Option 3] Google Maps API Key (Optional for Google Geocoding/Traffic API)
# Get a key at: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=

# Backend API URL (Leave blank if running through default Vite proxy)
VITE_API_BASE_URL=
